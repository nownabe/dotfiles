{
  "fmt": {
    "include": ["hooks/", "lib/", "tools/"],
    "lineWidth": 100
  },
  "lint": {
    "include": ["hooks/", "lib/", "tools/"]
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.18",
    "@std/testing": "jsr:@std/testing@^1.0.20"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env hooks/ lib/ tools/",
    "check:offline": "deno check --no-remote $(find hooks lib tools -name '*.ts' -not -name '*.test.ts')",
    "check": "deno fmt --check && deno lint && deno check hooks/ lib/ tools/ && deno task check:offline && deno task test"
  }
}

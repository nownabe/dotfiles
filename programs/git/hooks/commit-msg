#!/usr/bin/env bash
#
# Global commit-msg hook.
#
# Rejects Claude Code attribution (session URLs, Claude-Session trailers,
# Co-Authored-By: Claude, "Generated with Claude Code") in commit messages,
# then chains to the repo-local commit-msg hook.
#
# Not settings.json's `attribution`: that only suppresses what the harness
# adds on its own, and an agent can still type the line by hand. Not the
# Bash-level pattern guard either: a message passed with `-F <file>` or
# written in $EDITOR never appears in the command line it inspects. This
# hook is the one choke point every commit path goes through, whatever
# client produced the message.

set -o nounset
set -o pipefail

PREFIX="commit-msg"

# Kept in sync with the `preBash`/`preWrite` forbidden pattern of the same
# name in programs/claude/nownabe-claude-hooks.json.
FORBIDDEN='claude\.ai/(code/)?session_|^Claude-Session:|Co-Authored-By:[[:space:]]*Claude|Generated with \[?Claude Code'

chain_local_hook() {
  local common_dir local_hook
  common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || return 0
  local_hook="$common_dir/hooks/$PREFIX"

  [[ -x "$local_hook" ]] || return 0
  # Don't recurse into ourselves if hooksPath ever points at .git/hooks.
  [[ "$(realpath "$local_hook")" == "$(realpath "${BASH_SOURCE[0]}")" ]] && return 0

  "$local_hook" "$@"
}

main() {
  local msg_file="${1-}"

  # Chain first: a local hook may rewrite the message, and the rewritten
  # message is what actually gets committed.
  chain_local_hook "$@" || return $?

  [[ -f "$msg_file" ]] || return 0

  grep -qiE "$FORBIDDEN" -- "$msg_file" || return 0

  printf '%s: error: Claude Code attribution is not allowed in commit messages.\n' "$PREFIX" >&2
  printf '%s: offending line(s):\n' "$PREFIX" >&2
  grep -inE "$FORBIDDEN" -- "$msg_file" >&2
  printf '%s: remove the line and commit again. Never put a claude.ai session URL in a repository.\n' "$PREFIX" >&2
  return 1
}

main "$@"

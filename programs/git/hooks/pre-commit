#!/usr/bin/env bash
#
# Global pre-commit hook.
#
# Rejects staged content matching the machine-local private patterns when
# the repository is not private, then chains to the repo-local pre-commit
# hook. See lib/private-patterns.bash for the two files involved.
#
# Only added lines are scanned. Content already present in a file has
# already been committed, so flagging it would fail every later commit
# that touches the file without changing what is public.

set -o nounset
set -o pipefail

PREFIX="pre-commit"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/private-patterns.bash
source "$(dirname "${BASH_SOURCE[0]}")/lib/private-patterns.bash"

chain_local_hook() {
  local common_dir local_hook
  common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || return 0
  local_hook="$common_dir/hooks/$PREFIX"

  [[ -x "$local_hook" ]] || return 0
  # Don't recurse into ourselves if hooksPath ever points at .git/hooks.
  [[ "$(realpath "$local_hook")" == "$(realpath "${BASH_SOURCE[0]}")" ]] && return 0

  "$local_hook" "$@"
}

main() {
  chain_local_hook "$@" || return $?

  local patterns
  patterns=$(private_patterns) || return 0

  local pattern_tmp
  pattern_tmp=$(mktemp) || return 0
  printf '%s\n' "$patterns" > "$pattern_tmp"
  trap 'rm -f "$pattern_tmp"' RETURN

  local found=0 file added
  while IFS= read -r -d '' file; do
    # -U0 keeps context lines out; `+++` is the file header, not content.
    added=$(git diff --cached -U0 --no-color -- "$file" |
      grep -E '^\+' | grep -vE '^\+\+\+') || continue

    local hits
    hits=$(printf '%s\n' "$added" | grep -inE -f "$pattern_tmp") || continue

    if [[ $found -eq 0 ]]; then
      printf '%s: error: staged content matches a private pattern from %s\n' \
        "$PREFIX" "$PRIVATE_PATTERNS_FILE" >&2
      found=1
    fi
    printf '%s: %s\n' "$PREFIX" "$file" >&2
    printf '%s\n' "$hits" | sed "s/^/$PREFIX:   /" >&2
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)

  [[ $found -eq 0 ]] && return 0

  printf '%s: this repository is not listed in %s. Unstage the offending lines before committing.\n' \
    "$PREFIX" "$PRIVATE_REMOTES_FILE" >&2
  return 1
}

main "$@"
